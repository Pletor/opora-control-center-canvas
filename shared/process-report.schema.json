{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opora://shared/process-report.schema.json",
  "title": "Opora process report",
  "description": "Odpověď agenta do běžícího procesu. Append-only soubor processes/<process-id>/reports/<timestamp>-<agent>.json. Nikdy nepřerušuje proces; kontext je součástí každé odpovědi.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "processId", "processRevision", "at", "by", "context", "kind", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^rpt-[0-9a-f]{12}$" },
    "processId": { "type": "string", "pattern": "^prc-[0-9a-f]{12}$" },
    "processRevision": { "type": "integer", "minimum": 1, "description": "revize procesu, kterou agent četl; při neshodě se odpověď uloží, ale označí jako stale" },
    "at": { "type": "string", "format": "date-time" },
    "by": { "$ref": "process.schema.json#/$defs/actor" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "lastStepId"],
      "properties": {
        "worktree": { "type": ["string", "null"] },
        "lastStepId": { "type": ["string", "null"] },
        "session": { "type": ["string", "null"], "maxLength": 200, "description": "identifikátor session agenta pro navázání bez ztráty kontextu" }
      }
    },
    "kind": { "type": "string", "enum": ["progress", "step_done", "step_failed", "question", "result"] },
    "stepId": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "outputs": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "process.schema.json#/properties/outputs/items" }
    },
    "error": { "type": ["string", "null"], "maxLength": 4000, "description": "povinné pro step_failed; přepne proces do repair" },
    "stale": { "type": "boolean", "default": false }
  }
}
