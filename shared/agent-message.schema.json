{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opora.agent-message/1",
  "title": "Opora agent message v1",
  "type": "object",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120},
    "label": {"type": "string", "minLength": 1, "maxLength": 120, "not": {"pattern": "\\u0000"}},
    "body": {"type": "string", "minLength": 1, "maxLength": 12000, "not": {"pattern": "\\u0000"}},
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "project", "workspace", "sourceNodeId", "targetNodeId", "kind", "body", "replyToMessageId", "senderLabel", "identityVerified", "createdAt", "digest", "receipt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1},
        "project": {"$ref": "#/$defs/id"}, "workspace": {"$ref": "#/$defs/id"},
        "sourceNodeId": {"$ref": "#/$defs/id"}, "targetNodeId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["handoff", "question", "answer", "blocker", "result", "correction"]},
        "body": {"$ref": "#/$defs/body"}, "replyToMessageId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "senderLabel": {"$ref": "#/$defs/label"}, "identityVerified": {"const": false},
        "createdAt": {"type": "string", "format": "date-time"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}]}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "note", "recipientLabel", "identityVerified", "createdAt"],
      "properties": {"disposition": {"enum": ["accepted", "rejected", "needs_clarification"]}, "note": {"type": "string", "maxLength": 12000}, "recipientLabel": {"$ref": "#/$defs/label"}, "identityVerified": {"const": false}, "createdAt": {"type": "string", "format": "date-time"}}
    }
  },
  "oneOf": [
    {"title": "CreateMessage", "additionalProperties": false, "required": ["project", "workspace", "sourceNodeId", "targetNodeId", "kind", "body", "replyToMessageId", "idempotencyKey", "senderLabel"], "properties": {"project": {"$ref": "#/$defs/id"}, "workspace": {"$ref": "#/$defs/id"}, "sourceNodeId": {"$ref": "#/$defs/id"}, "targetNodeId": {"$ref": "#/$defs/id"}, "kind": {"enum": ["handoff", "question", "answer", "blocker", "result", "correction"]}, "body": {"$ref": "#/$defs/body"}, "replyToMessageId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "idempotencyKey": {"$ref": "#/$defs/id"}, "senderLabel": {"$ref": "#/$defs/label"}}},
    {"title": "CreateReceipt", "additionalProperties": false, "required": ["project", "workspace", "nodeId", "messageId", "digest", "disposition", "note", "recipientLabel"], "properties": {"project": {"$ref": "#/$defs/id"}, "workspace": {"$ref": "#/$defs/id"}, "nodeId": {"$ref": "#/$defs/id"}, "messageId": {"$ref": "#/$defs/id"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "disposition": {"enum": ["accepted", "rejected", "needs_clarification"]}, "note": {"type": "string", "maxLength": 12000}, "recipientLabel": {"$ref": "#/$defs/label"}}},
    {"$ref": "#/$defs/message"}
  ]
}
