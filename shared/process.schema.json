{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opora://shared/process.schema.json",
  "title": "Opora process",
  "description": "Proces uvnitř složky projektu: návrh → proces → hotovo → oprava. Soubor processes/<process-id>/process.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "title", "state", "createdAt", "updatedAt", "revision", "owner", "inputs", "steps", "outputs", "failure", "history"],
  "properties": {
    "id": { "type": "string", "pattern": "^prc-[0-9a-f]{12}$" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "nodeId": { "type": ["string", "null"], "maxLength": 64 },
    "sectorId": { "type": ["string", "null"], "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "state": { "type": "string", "enum": ["draft", "running", "done", "repair"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 },
    "owner": { "$ref": "#/$defs/actor" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeText": { "type": ["string", "null"], "description": "cesta nodes/<id>/text.md nebo null" },
        "spec": { "type": ["string", "null"], "description": "cesta nodes/<id>/spec.json nebo null" },
        "packet": { "type": ["string", "null"], "description": "cesta packets/<snapshot-id>.json nebo null" },
        "worktree": { "type": ["string", "null"], "description": "id worktree (worktrees/<id>) nebo null = bez worktree, výslovně" },
        "references": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 200 }
      },
      "required": ["worktree", "references"]
    },
    "steps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "state", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^stp-[0-9a-f]{8}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "state": { "type": "string", "enum": ["pending", "running", "done", "failed"] },
          "evidence": { "type": ["object", "null"], "$ref": "#/$defs/evidence" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "enum": ["json", "db", "md", "file"] },
          "ref": { "type": "string", "minLength": 1, "maxLength": 500, "description": "cesta relativní ke složce projektu, nebo tabulka:id pro db" },
          "digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "stepId", "at", "reportedBy"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "stepId": { "type": ["string", "null"] },
        "at": { "type": "string", "format": "date-time" },
        "reportedBy": { "$ref": "#/$defs/actor" },
        "fix": { "type": ["string", "null"], "maxLength": 2000, "description": "popis opravy, povinný pro přechod repair → running" }
      }
    },
    "history": {
      "type": "array",
      "description": "Append-only přechody stavů; nikdy se nemažou ani nepřepisují.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at", "by", "note"],
        "properties": {
          "from": { "type": ["string", "null"], "enum": ["draft", "running", "done", "repair", null] },
          "to": { "type": "string", "enum": ["draft", "running", "done", "repair"] },
          "at": { "type": "string", "format": "date-time" },
          "by": { "$ref": "#/$defs/actor" },
          "note": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "enum": ["human", "agent", "system"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "at", "by"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "at": { "type": "string", "format": "date-time" },
        "by": { "$ref": "#/$defs/actor" },
        "reportId": { "type": ["string", "null"], "description": "soubor v reports/, ze kterého důkaz pochází" },
        "outputs": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    }
  }
}
