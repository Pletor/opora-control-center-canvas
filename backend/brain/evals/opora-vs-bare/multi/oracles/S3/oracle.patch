+  return (
+    <>
+      <section data-opora-section="hero" className="hero">
+        <h1>Příběhy absolventů</h1>
+        <p>Začínali stejně jako vy. Tady je, jak to dopadlo.</p>
+      </section>
+      <section data-opora-section="pribehy">
+        {PRIBEHY.map((p) => (
+          <article key={p.id} className="pribeh">
+            <blockquote>{p.text}</blockquote>
+            <p>{p.jmeno}</p>
+          </article>
+        ))}
+      </section>
+    </>
+  );
+}
