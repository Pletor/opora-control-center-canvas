+const OTAZKY = [
+  ["Zvládnu to, i když mi zatím všechno uschlo?", "Ano. Kurz počítá právě s tím a začíná nejodolnějšími rostlinami."],
+  ["Kolik času týdně to zabere?", "Lekce má kolem 20 minut, péče o balkon pár minut denně."],
+  ["Potřebuji velký balkon?", "Ne, stačí parapet nebo dva truhlíky."],
+  ["Co když mám balkon na sever?", "Ukážeme rostliny, kterým stín nevadí."],
+  ["Můžu začít zdarma?", "Ano, varianta Samouk je zdarma."],
+  ["Jak se vám ozvu, když si nevím rady?", "Napište nám přes kontaktní formulář, odpovíme do dvou pracovních dnů."],
+];
+
+export default function Faq() {
+  return (
+    <>
+      <section data-opora-section="hero" className="hero">
+        <h1>Časté otázky</h1>
+      </section>
+      <section data-opora-section="otazky">
+        {OTAZKY.map(([q, a]) => (
+          <details key={q}>
+            <summary>{q}</summary>
+            <p>{a}</p>
+          </details>
+        ))}
+      </section>
+    </>
+  );
+}
