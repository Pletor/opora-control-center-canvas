+++ b/src/pages/Kontakt.tsx
@@ -0,0 +1,49 @@
+import { useState, type FormEvent } from "react";
+import { useNavigate } from "react-router-dom";
+import { validate, type Errors, type Values } from "../kontakt/validate";
+
+export default function Kontakt() {
+  const navigate = useNavigate();
+  const [values, setValues] = useState<Values>({ jmeno: "", email: "", zprava: "" });
+  const [errors, setErrors] = useState<Errors>({});
+  const set = (k: keyof Values) => (e: { target: { value: string } }) => setValues({ ...values, [k]: e.target.value });
+
+  function submit(e: FormEvent) {
+    e.preventDefault();
+    const found = validate(values);
+    setErrors(found);
+    if (Object.keys(found).length === 0) navigate("/dekujeme");
+  }
+
+  return (
+    <>
+      <section data-opora-section="hero" className="hero">
+        <h1>Napište nám</h1>
+        <p>Ozveme se do dvou pracovních dnů. Žádný spěch, žádné závazky.</p>
+      </section>
+      <section data-opora-section="form">
+        <form className="form" onSubmit={submit} noValidate>
+          <div className="field">
+            <label htmlFor="jmeno">Jméno</label>
+            <input id="jmeno" value={values.jmeno} onChange={set("jmeno")}
+              aria-invalid={errors.jmeno ? true : undefined} aria-describedby={errors.jmeno ? "jmeno-chyba" : undefined} />
+            {errors.jmeno && <p id="jmeno-chyba" className="field__error" role="alert">{errors.jmeno}</p>}
+          </div>
+          <div className="field">
+            <label htmlFor="email">E-mail</label>
+            <input id="email" type="email" value={values.email} onChange={set("email")}
+              aria-invalid={errors.email ? true : undefined} aria-describedby={errors.email ? "email-chyba" : undefined} />
+            {errors.email && <p id="email-chyba" className="field__error" role="alert">{errors.email}</p>}
+          </div>
+          <div className="field">
+            <label htmlFor="zprava">Zpráva</label>
+            <textarea id="zprava" rows={5} value={values.zprava} onChange={set("zprava")}
+              aria-invalid={errors.zprava ? true : undefined} aria-describedby={errors.zprava ? "zprava-chyba" : undefined} />
+            {errors.zprava && <p id="zprava-chyba" className="field__error" role="alert">{errors.zprava}</p>}
+          </div>
+          <button type="submit" className="button">Odeslat</button>
+        </form>
+      </section>
+    </>
+  );
+}
