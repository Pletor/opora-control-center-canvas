diff --git a/src/styles.css b/src/styles.css
new file mode 100644
index 0000000..90a8801
--- /dev/null
+++ b/src/styles.css
@@ -0,0 +1,19 @@
+/* Klidná zelená a hodně vzduchu, žádná křiklavá barva: začátečník má mít pocit, že to zvládne. */
+:root { --bg: #f6f7f2; --ink: #22301f; --leaf: #3f6b3a; --soft: #e3ebdc; --warn: #8a5a2b; }
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.6 system-ui, sans-serif; }
+.top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 24px; }
+.top__brand { font-weight: 700; color: var(--leaf); }
+.nav__list { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; }
+.nav__list a { color: var(--ink); text-decoration: none; }
+.nav__list a.active { color: var(--leaf); text-decoration: underline; }
+.page { max-width: 760px; margin: 0 auto; padding: 8px 24px 48px; }
+.hero { padding: 32px 0 16px; }
+.button { display: inline-block; background: var(--leaf); color: #fff; border: 0; border-radius: 8px; padding: 10px 18px; font: inherit; text-decoration: none; cursor: pointer; }
+.button:disabled { opacity: 0.6; cursor: progress; }
+a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid var(--leaf); outline-offset: 2px; }
+.form { display: grid; gap: 16px; }
+.field { display: grid; gap: 4px; }
+.field input, .field textarea { font: inherit; padding: 8px 10px; border: 1px solid #b9c4b1; border-radius: 6px; }
+.field input[aria-invalid="true"], .field textarea[aria-invalid="true"] { border-color: var(--warn); }
+.field__error, .form__error { color: var(--warn); margin: 0; }
