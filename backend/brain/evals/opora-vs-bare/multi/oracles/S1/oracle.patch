+import { expect, test } from "vitest";
+import { validate } from "./validate";
+
+test("prázdný formulář má chybu u všech polí", () => {
+  expect(Object.keys(validate({ jmeno: "", email: "", zprava: "" })).sort()).toEqual(["email", "jmeno", "zprava"]);
+});
+
+test("zpráva kratší než 10 znaků neprojde", () => {
+  expect(validate({ jmeno: "Jana", email: "jana@example.cz", zprava: "Ahoj" })).toEqual({ zprava: "Napište prosím aspoň 10 znaků." });
+});
diff --git a/src/kontakt/validate.ts b/src/kontakt/validate.ts
new file mode 100644
index 0000000..577717e
--- /dev/null
+++ b/src/kontakt/validate.ts
@@ -0,0 +1,10 @@
+export type Values = { jmeno: string; email: string; zprava: string };
+export type Errors = Partial<Record<keyof Values, string>>;
+
+export function validate(v: Values): Errors {
+  const errors: Errors = {};
+  if (!v.jmeno.trim()) errors.jmeno = "Vyplňte prosím jméno.";
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email.trim())) errors.email = "Zadejte e-mail ve tvaru jana@example.cz.";
+  if (v.zprava.trim().length < 10) errors.zprava = "Napište prosím aspoň 10 znaků.";
+  return errors;
+}
