--- /dev/null
+++ b/src/kurz/terminy.ts
@@ -0,0 +1,31 @@
+// Kalendářové API termínů v repozitáři zatím není (ceník žádné API nevolá): stránka ho volá a když neodpoví,
+// řekne to srozumitelně a zbytek kurzu funguje dál.
+export type Termin = { id: string; nazev: string; datum: string };
+
+function list(data: unknown): unknown[] {
+  if (Array.isArray(data)) return data;
+  if (data && typeof data === "object") {
+    const inner = (data as Record<string, unknown>).terminy;
+    if (Array.isArray(inner)) return inner;
+  }
+  return [];
+}
+
+export function parseTerminy(data: unknown): Termin[] {
+  return list(data).flatMap((item) => {
+    if (!item || typeof item !== "object") return [];
+    const t = item as Record<string, unknown>;
+    if (typeof t.id !== "string" || !t.id) return [];
+    return [{ id: t.id, nazev: String(t.nazev ?? t.id), datum: String(t.datum ?? "") }];
+  });
+}
+
+export async function loadTerminy(): Promise<Termin[] | null> {
+  try {
+    const res = await fetch("/api/terminy", { headers: { Accept: "application/json" } });
+    if (!res.ok) return null;
+    return parseTerminy(await res.json());
+  } catch {
+    return null;
+  }
+}
