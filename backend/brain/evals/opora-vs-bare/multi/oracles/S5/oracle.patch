+afterEach(() => vi.unstubAllGlobals());
+
+test("termíny z pole i z objektu, neplatné položky pryč", () => {
+  expect(parseTerminy([{ id: "t1", nazev: "Podzim", datum: "2026-11-12" }, { nazev: "bez id" }])).toEqual([
+    { id: "t1", nazev: "Podzim", datum: "2026-11-12" },
+  ]);
+  expect(parseTerminy({ terminy: [{ id: "t2" }] })).toEqual([{ id: "t2", nazev: "t2", datum: "" }]);
+});
