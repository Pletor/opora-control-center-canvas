--- /dev/null
+++ b/src/kontakt/api.ts
@@ -0,0 +1,14 @@
+import type { Values } from "./validate";
+
+export async function sendPoptavka(body: Values & { varianta: string }): Promise<boolean> {
+  try {
+    const res = await fetch("/api/poptavka", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+    });
+    return res.ok;
+  } catch {
+    return false;
+  }
+}
