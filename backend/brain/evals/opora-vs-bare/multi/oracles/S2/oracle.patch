@@ -0,0 +1,13 @@
+import { afterEach, expect, test, vi } from "vitest";
+import { sendPoptavka } from "./api";
+
+afterEach(() => vi.unstubAllGlobals());
+
+test("poptávka jde jako JSON s variantou a chyba serveru vrátí false", async () => {
+  const fetchMock = vi.fn().mockResolvedValue({ ok: false });
+  vi.stubGlobal("fetch", fetchMock);
+  const ok = await sendPoptavka({ jmeno: "Jana", email: "jana@example.cz", zprava: "Rajčata usychají.", varianta: "pruvodce" });
+  expect(ok).toBe(false);
+  expect(fetchMock.mock.calls[0][0]).toBe("/api/poptavka");
+  expect(JSON.parse(fetchMock.mock.calls[0][1].body).varianta).toBe("pruvodce");
+});
