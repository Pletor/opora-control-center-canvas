+export const VARIANTY = [
+  { id: "samouk", nazev: "Samouk", cena: "0 Kč", popis: "Všechny lekce, tempo si určujete sami." },
+  { id: "pruvodce", nazev: "Průvodce", cena: "990 Kč", popis: "Lekce a týdenní připomínky, co zrovna dělat." },
+  { id: "mentor", nazev: "S mentorem", cena: "2490 Kč", popis: "K tomu tři konzultace nad fotkami vašeho balkonu." },
+];
+
+export default function Cenik() {
+  return (
+    <>
+      <section data-opora-section="hero" className="hero">
+        <h1>Ceník</h1>
+        <p>Vyberte si, kolik podpory chcete. Začít můžete i zdarma.</p>
+      </section>
+      <section data-opora-section="varianty" className="cenik">
+        {VARIANTY.map((v) => (
+          <article key={v.id} className="cenik__varianta">
+            <h2>{v.nazev}</h2>
+            <p className="cenik__cena">{v.cena}</p>
+            <p>{v.popis}</p>
+            <Link className="button" to={`/kontakt?varianta=${v.id}`}>Vybrat</Link>
+          </article>
+        ))}
+      </section>
+    </>
+  );
+}
